{
    "name": "tauri-app",
    "private": true,
    "version": "5.2.0",
    "type": "module",
    "scripts": {
        "sync:version": "node scripts/sync-version.mjs",
        "predev": "node scripts/sync-version.mjs && powershell -NoProfile -ExecutionPolicy Bypass -Command \"$p=(Get-NetTCPConnection -LocalPort 1430 -State Listen -ErrorAction SilentlyContinue).OwningProcess; if ($p) { Stop-Process -Id $p -Force -ErrorAction SilentlyContinue; Start-Sleep -m 500 }\"",
        "dev": "vite",
        "prebuild": "node scripts/sync-version.mjs",
        "build": "vite build",
        "prebuild:signed": "node scripts/sync-version.mjs",
        "build:signed": "node scripts/run-powershell-script.mjs scripts/build-signed.ps1",
        "preview": "vite preview",
        "prerelease:prepare": "node scripts/sync-version.mjs",
        "release:prepare": "node scripts/run-powershell-script.mjs scripts/release.ps1",
        "pretauri": "node scripts/sync-version.mjs",
        "tauri": "node scripts/run-tauri.mjs"
    },
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2.6.0",
        "@tauri-apps/plugin-opener": "^2",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-updater": "^2.10.0",
        "highlight.js": "^11.11.1",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "@vitejs/plugin-vue": "^5.2.1",
        "vite": "^6.0.3"
    }
}
